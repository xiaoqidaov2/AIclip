# LLM Configuration
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0

# Vision Model Entry (optional; defaults to OPENAI_* when unset)
AICLIP_VISION_API_BASE=https://dashscope.aliyuncs.com/api/v1
AICLIP_VISION_API_KEY=your-dashscope-api-key-here
AICLIP_DASHSCOPE_BASE=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=your-dashscope-api-key-here
AICLIP_VISION_MODEL=qwen3-vl-plus
AICLIP_VISION_TIMEOUT=180
AICLIP_VISION_MAX_RETRIES=3
AICLIP_VISION_RETRY_BASE=1.5

# Net Asset Search APIs
PEXELS_API_KEY=your-pexels-api-key-here
PIXABAY_API_KEY=your-pixabay-api-key-here
FREESOUND_CLIENT_ID=your-freesound-client-id-here
NET_ASSET_CACHE_DIR=tmp/net_asset_cache

# Project workspace root (stores projects registry and managed project folders)
AICLIP_WORKSPACE=~/.aiclip